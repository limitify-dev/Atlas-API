# ============================================
# Atlas API Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================
# Application Configuration
# ============================================
PORT=4000
NODE_ENV=production

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Example: postgresql://myuser:mypassword@db.example.com:5432/atlas?schema=public
DATABASE_URL="postgresql://atlas:atlas@localhost:5432/atlas?schema=public"
POSTGRES_DB="atlas"
POSTGRES_USER="atlas"
POSTGRES_PASSWORD="atlas"
POSTGRES_PORT=5432

# ============================================
# Supabase Configuration
# ============================================
# Get these from your Supabase project settings
# https://app.supabase.com/project/_/settings/api
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-key"

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
# Token lifetimes in seconds (defaults: 900 = 15min, 604800 = 7 days)
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# ============================================
# Redis Configuration
# ============================================
# Redis connection URL for BullMQ queues and Socket.io
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379

# ============================================
# Push Notifications Configuration
# ============================================
# Expo Push Notifications (mobile)
# No key needed - uses Expo's free push service

# Firebase Cloud Messaging (web push) - Optional for Phase 1
# FIREBASE_PROJECT_ID="your-firebase-project-id"
# FIREBASE_CLIENT_EMAIL="your-firebase-client-email"
# FIREBASE_PRIVATE_KEY="your-firebase-private-key"

# ============================================
# CORS Configuration
# ============================================
# Comma-separated allow-list. Falls back to FRONTEND_URL/WEB_URL below
# (plus local dev ports) if unset — set this explicitly in production.
CORS_ORIGINS="https://yourdomain.com,https://app.yourdomain.com"

# ============================================
# App URLs (used to build links in emails)
# ============================================
FRONTEND_URL="https://yourdomain.com"
WEB_URL="https://yourdomain.com"

# ============================================
# Twilio (SMS) Configuration
# ============================================
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+15555550100"

# ============================================
# SMTP (Email) Configuration
# ============================================
SMTP_HOST="smtp.example.com"
SMTP_PORT=465
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
# Optional overrides
# SMTP_SECURE="true"
# SMTP_FROM="Atlas <no-reply@yourdomain.com>"
