model ConsultationConfig {
  id                      String   @id @default(uuid())
  tenantId                String
  consultationDate        DateTime
  startTime               String
  /// Hard cutoff for the day — see AcademicsService.assertConsultationCapacity.
  /// Defaulted for pre-existing rows created before this field existed; the
  /// API requires it explicitly on every new create/update.
  endTime                 String   @default("17:00")
  defaultDurationMinutes  Int      @default(15)
  defaultLocation         String   @default("School Campus")
  title                   String   @default("Consultation Day")
  /// Global break: every teacher pauses and sessions resume afterwards.
  breakStartTime          String?
  breakDurationMinutes    Int?     @default(0)
  content                 String?
  /// Section (classroom) ids this day targets. Empty = every classroom.
  sectionIds              String[] @default([])
  isActive                Boolean  @default(true)
  createdBy               String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  teacherOverrides        ConsultationTeacherOverride[]

  @@index([tenantId])
  @@map("consultation_configs")
}

