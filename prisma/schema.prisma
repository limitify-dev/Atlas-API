  CLOSED // Window has ended
  CANCELLED // Abandoned before activation
}

// ─── Atlas Studio Models ──────────────────────────────────────────────────────

model StudioModule {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "academics", "attendance", "finance"
  name        String
  description String?
  isCore      Boolean  @default(false) // core modules can't be disabled
  createdAt   DateTime @default(now())

  tenantModules TenantModule[]

  @@map("studio_modules")
}

model TenantModule {
  id        String   @id @default(uuid())
  tenantId  String
  moduleId  String
  enabled   Boolean  @default(true)
  enabledAt DateTime @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module StudioModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
  @@index([tenantId])
  @@map("tenant_modules")
}

model StudioSubscription {
  id        String             @id @default(uuid())
  tenantId  String             @unique
  plan      SubscriptionPlan   @default(BASIC)
  status    SubscriptionStatus @default(TRIAL)
  startDate DateTime           @default(now())
  endDate   DateTime?
  notes     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("studio_subscriptions")
}

model AdminInvite {
  id        String            @id @default(uuid())
  tenantId  String
  phone     String?
  email     String?
  name      String?
  token     String            @unique @default(uuid())
  role      Role              @default(ADMIN)
  status    AdminInviteStatus @default(PENDING)
  expiresAt DateTime
  claimedAt DateTime?
  createdAt DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([token])
  @@map("admin_invites")
}

model TenantBilling {
  id           String        @id @default(uuid())
  tenantId     String
  billingCycle BillingCycle
  amount       Decimal       @db.Decimal(10, 2)
  currency     String        @default("USD")
  dueDate      DateTime
  periodStart  DateTime
  periodEnd    DateTime
  status       BillingStatus @default(PENDING)
  source       BillingSource @default(MANUAL)
  notes        String?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
  @@map("tenant_billings")
}

model AdminApproval {
  id          String              @id @default(uuid())
  tenantId    String
  userId      String              @unique
  status      AdminApprovalStatus @default(PENDING)
  requestedAt DateTime            @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  notes       String?

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User   @relation("ApprovalUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?  @relation("ApprovalReviewer", fields: [reviewedBy], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("admin_approvals")
}

/// A public "request to onboard" submission from a prospective school
/// (via the marketing site's get-started/demo/enroll form) — this is
/// pre-tenant, so it's deliberately NOT tenant-scoped. Reviewing a request
/// is a track-and-contact action only; it does not create a Tenant or
/// AdminInvite — a Studio operator still does that manually via the
/// existing tools once they've followed up.
model OnboardingRequest {
  id             String                  @id @default(uuid())
  intent         OnboardingRequestIntent @default(GET_STARTED)
  fullName       String
  email          String
  phone          String
  organization   String
  role           String
  schoolSize     String
  preferredDate  DateTime?
  preferredTime  String?
  goals          String
  status         OnboardingRequestStatus @default(NEW)
  notes          String?
  createdAt      DateTime                @default(now())
  reviewedAt     DateTime?
  reviewedById   String?

  reviewedBy User? @relation(fields: [reviewedById], references: [id])

  @@index([status])
  @@index([createdAt])
  @@map("onboarding_requests")
}

model Feedback {
  id             String           @id @default(uuid())
  tenantId       String
  userId         String
  category       FeedbackCategory
  message        String
  status         FeedbackStatus   @default(NEW)
  priority       FeedbackPriority @default(MEDIUM)
  plannedRelease String?
  createdAt      DateTime         @default(now())
  resolvedAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@map("feedback")
}

