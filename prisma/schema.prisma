// ─────────────────────────────────────────────────────────────
//  Subscription & Billing (manual payment tracking)
// ─────────────────────────────────────────────────────────────

enum TenantSubscriptionStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  SUSPENDED
}

enum SubscriptionPaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  MOBILE_MONEY
  CARD
  OTHER
}

enum SubscriptionCurrency {
  USD
  EUR
  GBP
  UGX
  KES
  TZS
  NGN
  ZAR
  RWF
  GHS
}

enum SubscriptionAuditAction {
  PAYMENT_LOGGED
  MANUALLY_EXTENDED
  MANUALLY_SUSPENDED
  MANUALLY_REACTIVATED
  STATUS_AUTO_EXPIRED
  STATUS_RECALCULATED
  PAYMENT_DELETED
  GRACE_PERIOD_UPDATED
}

model SubscriptionPayment {
  id           String                 @id @default(uuid())
  tenantId     String
  amount       Decimal                @db.Decimal(12, 2)
  currency     String                 @default("USD")
  paymentDate  DateTime               @default(now())
  periodStart  DateTime
  periodEnd    DateTime
  paymentMethod SubscriptionPaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?
  notes        String?
  recordedById String?
  createdAt    DateTime               @default(now())

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([paymentDate])
  @@index([periodEnd])
  @@map("subscription_payments")
}

model SubscriptionAuditLog {
  id         String                  @id @default(uuid())
  tenantId   String
  action     SubscriptionAuditAction
  performedById String?
  details    Json?
  createdAt  DateTime                @default(now())

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  performedBy User?  @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
  @@map("subscription_audit_logs")
}

// Platform-level key/value settings (e.g. support contact for the
// "Subscription Ended" screen). Editable by the super admin in Atlas-Studio.
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}
