// ─── NEW MODELS ──────────────────────────────────────────────────────────────

model AcademicTimeline {
  id           String               @id @default(uuid())
  tenantId     String
  name         String // e.g. "Term 1 Grade Submission Window"
  type         AcademicWindowType
  academicYear String // e.g. "2024-2025"
  term         String? // e.g. "T1", "T2", "S1" — null = applies to full year
  startDate    DateTime
  endDate      DateTime
  description  String?
  gradeIds     Json? // string[] | null — null means applies to all grades
  status       AcademicWindowStatus @default(DRAFT)
  createdBy    String // userId of the staff member who set this
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([type])
  @@index([academicYear])
  @@index([status])
  @@index([startDate, endDate])
  @@index([tenantId, type, status])
  @@map("academic_timelines")
}

model Promotion {
  id          String   @id @default(uuid())
  tenantId    String
  name        String // e.g. "Promotion 2023", "Class of 2028"
  entryYear   Int // year the cohort enrolled (e.g. 2023)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sections Section[]
  students Student[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([entryYear])
  @@index([isActive])
  @@map("promotions")
}

model Staff {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String   @unique
  firstName   String
  lastName    String
  department  String?
  staffRole   String // "studies" | "dos" | "discipline" | "dm" | "staff-academics" | "finance" | "bursar" | custom
  photoUrl    String?
  joiningDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([staffRole])
  @@map("staff")
}

model StudentGrade {
  id         String   @id @default(uuid())
  tenantId   String
  studentId  String
  subjectId  String
  term       String // e.g. "2025-T1"
  percentage Float
  comment    String?
  gradedBy   String // userId of the teacher
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, subjectId, term])
  @@index([tenantId])
  @@index([studentId])
  @@index([term])
  @@map("student_grades")
}

model Invoice {
   id          String        @id @default(uuid())
   tenantId    String
   studentId   String
   title       String
   description String?
   amount      Decimal       @db.Decimal(10, 2)
   currency    String        @default("USD")
   dueDate     DateTime
   term        String?
   category    String? // "tuition" | "transport" | "uniform" | custom
   status      InvoiceStatus @default(UNPAID)
   issuedBy    String // userId of finance staff who created it
   lockedAt    DateTime? // set when status = PENDING_VERIFICATION
   paidAt      DateTime? // when payment was confirmed
   amountPaid  Decimal?    @db.Decimal(10, 2) // tracked payment amount
   paymentMethod String? // "bank_transfer", "cash", "mobile_money", etc.
   gracePeriodApproved DateTime? // extends dueDate when grace is approved
   archivedAt  DateTime? // set when the fee item is archived; null = active
   createdAt   DateTime      @default(now())
   updatedAt   DateTime      @updatedAt

   student     Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
   tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
   submissions PaymentSubmission[]
   promises    PaymentPromise[]

   @@index([tenantId])
   @@index([studentId])
   @@index([status])
   @@index([dueDate])
   @@index([tenantId, studentId])
   @@index([archivedAt])
   @@map("invoices")
 }

model PaymentSubmission {
  id            String                  @id @default(uuid())
  tenantId      String
  invoiceId     String
  submittedBy   String // userId (parent)
  proofUrl      String? // Supabase storage URL (optional for parent mark-as-paid)
  note          String?
  amountClaimed Decimal?                @db.Decimal(10, 2)
  status        PaymentSubmissionStatus @default(PENDING_REVIEW)
  reviewedBy    String? // userId of finance staff
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([status])
  @@map("payment_submissions")
}

model PaymentPromise {
   id           String               @id @default(uuid())
   tenantId     String
   invoiceId    String
   promisedBy   String // userId (parent)
   promisedDate DateTime
   note         String?
   status       PaymentPromiseStatus @default(ACTIVE)
   approvedBy   String? // userId (finance staff) when approved/refused
   approvedAt   DateTime?
   approvalNote String? // bursar note when approving/refusing
   createdAt    DateTime             @default(now())
   updatedAt    DateTime             @updatedAt

   invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
   tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

   @@index([tenantId])
   @@index([invoiceId])
   @@index([status])
   @@index([promisedDate])
   @@map("payment_promises")
 }

