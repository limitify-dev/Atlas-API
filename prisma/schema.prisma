generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                       String                    @id @default(uuid())
  name                     String
  slug                     String                    @unique
  domain                   String?                   @unique
  logo                     String?
  address                  String?
  city                     String?
  state                    String?
  country                  String?
  zipCode                  String?
  phone                    String?
  email                    String?
  website                  String?
  status                   TenantStatus              @default(TRIAL)
  subscriptionPlan         SubscriptionPlan          @default(FREE)
  subscriptionStartDate    DateTime?
  subscriptionEndDate      DateTime?
  // ── Subscription & billing enforcement (authoritative source of truth) ──
  subscriptionStatus       TenantSubscriptionStatus? // cached/derived: ACTIVE | EXPIRING_SOON | EXPIRED | SUSPENDED
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  gracePeriodDays          Int                       @default(0)
  suspendedManually        Boolean                  @default(false)
  suspensionReason         String?
  maxStudents              Int                       @default(100)
  maxTeachers              Int                       @default(20)
  settings                 Json?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  timezone                 String                    @default("UTC")
  brandColor               String?                   @default("#1e40af")
  announcements            Announcement[]
  attendances              Attendance[]
  bookCopies               BookCopy[]
  bookTransactions         BookTransaction[]
  books                    Book[]
  cardLogs                 CardLog[]
  cardPermissions          CardPermission[]
  cards                    Card[]
  combinations             Combination[]
  conductPointTransactions ConductPointTransaction[]
  conductRecords           ConductRecord[]
  conversations            Conversation[]
  deviceLogs               DeviceLog[]
  devices                  Device[]
  events                   Event[]
  moments                  Moment[]
  grades                   Grade[]
  academicTimelines        AcademicTimeline[]
  invoices                 Invoice[]
  messages                 Message[]
  promotions               Promotion[]
  notifications            Notification[]
  parents                  Parent[]
  invites                  Invite[]
  paymentPromises          PaymentPromise[]
  paymentSubmissions       PaymentSubmission[]
  permissionUsages         PermissionUsage[]
  permissions              Permission[]
  sections                 Section[]
  staff                    Staff[]
  studentConductPoints     StudentConductPoints[]
  studentGrades            StudentGrade[]
  students                 Student[]
  subjects                 Subject[]
  teacherAttendances       TeacherAttendance[]
  teachers                 Teacher[]
  users                    User[]
  timetablePeriods         TimetablePeriod[]
  timetableEntries         TimetableEntry[]
  tenantModules            TenantModule[]
  studioSubscription       StudioSubscription?
  adminInvites             AdminInvite[]
  tenantBillings           TenantBilling[]
  adminApprovals           AdminApproval[]
  feedback                 Feedback[]
  subscriptionPayments     SubscriptionPayment[]
  subscriptionAuditLogs    SubscriptionAuditLog[]

  @@index([slug])
  @@index([status])
  @@index([subscriptionPlan])
  @@map("tenants")
}

model User {
  id                       String                    @id @default(uuid())
  tenantId                 String?
  email                    String?                   @unique
  name                     String
  password                 String
  phone                    String?                   @unique
  avatar                   String?
  role                     Role                      @default(STAFF)
  userType                 UserType?
  status                   Status                    @default(PENDING)
  emailVerified            Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  lastLoginAt              DateTime?
  passwordChangedAt        DateTime?
  username                 String                    @unique
  sentAnnouncements        Announcement[]
  chatMessages             ChatMessage[]
  conductRecordsReported   ConductRecord[]
  conversationParticipants ConversationParticipant[]
  receivedMessages         Message[]                 @relation("MessageReceiver")
  sentMessages             Message[]                 @relation("MessageSender")
  receivedNotifications    NotificationRecipient[]
  sentNotifications        Notification[]
  parent                   Parent?
  pushTokens               PushToken[]
  refreshTokens            RefreshToken[]
  sessions                 Session[]
  staff                    Staff?
  student                  Student?
  teacher                  Teacher?
  tenant                   Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adminApproval            AdminApproval?            @relation("ApprovalUser")
  reviewedApprovals        AdminApproval[]           @relation("ApprovalReviewer")
  reviewedOnboardingRequests OnboardingRequest[]
  feedback                 Feedback[]
  moments                  Moment[]                  @relation("TeacherMoments")
  momentLikes              MomentLike[]              @relation("UserMomentLikes")
  recordedPayments         SubscriptionPayment[]
  subscriptionAuditLogs    SubscriptionAuditLog[]
  systemSettings           SystemSetting[]

  @@index([tenantId])
  @@index([email])
  @@index([userType])
  @@index([status])
  @@index([role])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Student {
  id             String                @id @default(uuid())
  tenantId       String
  userId         String?               @unique
  studentId      String
  firstName      String
  lastName       String
  dateOfBirth    DateTime
  gender         Gender
  bloodGroup     String?
  nationality    String?
  address        String?
  photoUrl       String?
  rollNumber     String?
  admissionDate  DateTime
  gradeId        String
  sectionId      String
  promotionId    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  email          String?
  phone          String?
  attendances    Attendance[]
  borrowedBooks  BookTransaction[]
  card           Card?
  conductRecords ConductRecord[]
  invoices       Invoice[]
  permissions    Permission[]
  conductPoints  StudentConductPoints?
  parents        StudentParent[]
  studentGrades  StudentGrade[]
  grade          Grade                 @relation(fields: [gradeId], references: [id])
  promotion      Promotion?            @relation(fields: [promotionId], references: [id])
  section        Section               @relation(fields: [sectionId], references: [id])
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId])
  @@index([tenantId])
  @@index([userId])
  @@index([studentId])
  @@index([gradeId])
  @@index([sectionId])
  @@index([promotionId])
  @@map("students")
}

model Parent {
  id           String          @id @default(uuid())
  tenantId     String
  userId       String          @unique
  firstName    String
  lastName     String
  relationship String?
  occupation   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  children     StudentParent[]

  @@index([tenantId])
  @@index([userId])
  @@map("parents")
}

model StudentParent {
  id        String   @id @default(uuid())
  studentId String
  parentId  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([studentId])
  @@index([parentId])
  @@map("student_parents")
}

model Teacher {
  id               String              @id @default(uuid())
  tenantId         String
  userId           String              @unique
  teacherId        String
  firstName        String
  lastName         String
  dateOfBirth      DateTime?
  gender           Gender?
  qualification    String?
  specialization   String?
  joiningDate      DateTime
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  department       String?
  photoUrl         String?
  card             Card?
  classes          ClassTeacher[]
  conductRecords   ConductRecord[]
  subjects         SubjectTeacher[]
  attendances      TeacherAttendance[]
  timetableEntries TimetableEntry[]
  consultationOverrides ConsultationTeacherOverride[]
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, teacherId])
  @@index([tenantId])
  @@index([userId])
  @@index([teacherId])
  @@map("teachers")
}

model Grade {
  id             String         @id @default(uuid())
  tenantId       String
  name           String
  level          Int
  description    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  code           String
  schoolLevel    SchoolLevel
  educationLevel EducationLevel
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sections       Section[]
  students       Student[]
  subjects       Subject[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([code])
  @@index([schoolLevel])
  @@index([educationLevel])
  @@map("grades")
}

model Combination {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  code        String
  description String?
  subjectIds  Json
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sections    Section[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([code])
  @@map("combinations")
}

model Section {
  id               String            @id @default(uuid())
  tenantId         String
  name             String
  gradeId          String
  promotionId      String?
  capacity         Int               @default(40)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  combinationId    String?
  division         String?
  isActive         Boolean           @default(true)
  bookTransactions BookTransaction[]
  classes          ClassTeacher[]
  combination      Combination?      @relation(fields: [combinationId], references: [id])
  grade            Grade             @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  promotion        Promotion?        @relation(fields: [promotionId], references: [id])
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students         Student[]
  conversations    Conversation[]
  timetableEntries TimetableEntry[]

  @@unique([tenantId, gradeId, name])
  @@index([tenantId])
  @@index([gradeId])
  @@index([combinationId])
  @@index([promotionId])
  @@map("sections")
}

model Subject {
  id               String           @id @default(uuid())
  tenantId         String
  name             String
  code             String
  description      String?
  gradeId          String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  studentGrades    StudentGrade[]
  teachers         SubjectTeacher[]
  grade            Grade            @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([gradeId])
  @@index([code])
  @@map("subjects")
}

model ClassTeacher {
  id        String   @id @default(uuid())
  teacherId String
  sectionId String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, sectionId])
  @@index([teacherId])
  @@index([sectionId])
  @@map("class_teachers")
}

model SubjectTeacher {
  id        String   @id @default(uuid())
  teacherId String
  subjectId String
  createdAt DateTime @default(now())
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@index([teacherId])
  @@index([subjectId])
  @@map("subject_teachers")
}

/// Per-tenant timetable period definitions (admin-customizable slots & durations).
model TimetablePeriod {
  id         String           @id @default(uuid())
  tenantId   String
  label      String
  startTime  String
  endTime    String
  orderIndex Int
  isBreak    Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries    TimetableEntry[]

  @@unique([tenantId, orderIndex])
  @@index([tenantId])
  @@map("timetable_periods")
}

/// A single scheduled lesson: a class at a day+period, optionally with subject & teacher.
/// Uniqueness constraints prevent class and teacher double-booking.
model TimetableEntry {
  id        String          @id @default(uuid())
  tenantId  String
  sectionId String
  periodId  String
  dayOfWeek DayOfWeek
  subjectId String?
  teacherId String?
  room      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  period    TimetablePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  section   Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject   Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher   Teacher?        @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([sectionId, dayOfWeek, periodId])
  @@unique([teacherId, dayOfWeek, periodId])
  @@index([tenantId])
  @@index([sectionId])
  @@index([teacherId])
  @@index([periodId])
  @@map("timetable_entries")
}

model Attendance {
  id          String           @id @default(uuid())
  tenantId    String
  studentId   String
  status      AttendanceStatus
  remarks     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  checkInTime DateTime?
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([studentId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, studentId, createdAt])
  @@map("attendances")
}

model TeacherAttendance {
  id           String           @id @default(uuid())
  tenantId     String
  teacherId    String
  status       AttendanceStatus
  checkInTime  DateTime?
  checkOutTime DateTime?
  remarks      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  teacher      Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([teacherId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, teacherId, createdAt])
  @@map("teacher_attendances")
}

model Book {
  id              String            @id @default(uuid())
  tenantId        String
  title           String
  author          String
  isbn            String
  publisher       String?
  publicationYear Int?
  category        String
  totalCopies     Int               @default(1)
  availableCopies Int               @default(1)
  description     String?
  imageUrl        String?
  status          BookStatus        @default(AVAILABLE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  price           Float             @default(0)
  copies          BookCopy[]
  transactions    BookTransaction[]
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, isbn])
  @@index([tenantId])
  @@index([isbn])
  @@index([category])
  @@index([status])
  @@map("books")
}

model BookCopy {
  id           String            @id @default(uuid())
  tenantId     String
  bookId       String
  code         String
  shelf        String?
  status       BookStatus        @default(AVAILABLE)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  book         Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions BookTransaction[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([bookId])
  @@index([status])
  @@index([shelf])
  @@map("book_copies")
}

model BookTransaction {
  id         String    @id @default(uuid())
  tenantId   String
  bookId     String
  studentId  String?
  issueDate  DateTime  @default(now())
  dueDate    DateTime
  returnDate DateTime?
  fine       Float?    @default(0)
  remarks    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  bookCopyId String?
  sectionId  String?
  bookCopy   BookCopy? @relation(fields: [bookCopyId], references: [id], onDelete: Cascade)
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  section    Section?  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student    Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bookId])
  @@index([bookCopyId])
  @@index([studentId])
  @@index([sectionId])
  @@index([issueDate])
  @@index([returnDate])
  @@map("book_transactions")
}

model Permission {
  id             String                @id @default(uuid())
  tenantId       String
  studentId      String
  requestDate    DateTime              @default(now())
  fromDate       DateTime
  toDate         DateTime
  reason         String
  status         PermissionStatus      @default(PENDING)
  approvedBy     String?
  approvedAt     DateTime?
  remarks        String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  fromTime       String?
  permissionType PermissionType        @default(ONE_TIME)
  qrCode         String?
  qrCodeUsed     Boolean               @default(false)
  requestedBy    PermissionRequestedBy @default(ADMIN)
  requestedById  String
  schedule       Json?
  title          String?
  toTime         String?
  usedAt         DateTime?
  usages         PermissionUsage[]
  student        Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([studentId])
  @@index([status])
  @@index([permissionType])
  @@index([fromDate, toDate])
  @@index([qrCodeUsed])
  @@map("permissions")
}

model PermissionUsage {
  id           String     @id @default(uuid())
  tenantId     String
  permissionId String
  usedAt       DateTime   @default(now())
  checkoutTime DateTime
  location     String?
  cardLogId    String?
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([permissionId])
  @@index([usedAt])
  @@map("permission_usages")
}

model ConductRecord {
  id                String                    @id @default(uuid())
  tenantId          String
  studentId         String
  type              ConductType
  description       String
  date              DateTime                  @default(now())
  reportedBy        String?
  severity          Int                       @default(1)
  actionTaken       String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  incidentStatus    IncidentStatus            @default(ACTIVE)
  pointsDeducted    Int?
  resolutionNotes   String?
  resolvedAt        DateTime?
  resolvedBy        String?
  reportedByUserId  String?
  pointTransactions ConductPointTransaction[]
  reportedByUser    User?                     @relation(fields: [reportedByUserId], references: [id])
  teacher           Teacher?                  @relation(fields: [reportedBy], references: [id])
  student           Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([studentId])
  @@index([type])
  @@index([date])
  @@index([incidentStatus])
  @@map("conduct_records")
}

model StudentConductPoints {
  id            String                    @id @default(uuid())
  tenantId      String
  studentId     String                    @unique
  currentPoints Int                       @default(100)
  lastUpdatedAt DateTime                  @default(now())
  createdAt     DateTime                  @default(now())
  transactions  ConductPointTransaction[]
  student       Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([currentPoints])
  @@map("student_conduct_points")
}

model ConductPointTransaction {
  id                     String               @id @default(uuid())
  tenantId               String
  studentConductPointsId String
  conductRecordId        String?
  transactionType        PointTransactionType
  pointsChange           Int
  pointsBefore           Int
  pointsAfter            Int
  reason                 String
  recordedBy             String
  recordedAt             DateTime             @default(now())
  conductRecord          ConductRecord?       @relation(fields: [conductRecordId], references: [id])
  studentConductPoints   StudentConductPoints @relation(fields: [studentConductPointsId], references: [id], onDelete: Cascade)
  tenant                 Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([studentConductPointsId])
  @@index([conductRecordId])
  @@index([recordedAt])
  @@index([transactionType])
  @@map("conduct_point_transactions")
}

model Conversation {
  id            String                    @id @default(uuid())
  tenantId      String
  type          ConversationType          @default(DIRECT)
  name          String?
  description   String?
  avatar        String?
  sectionId     String?
  createdBy     String?
  isReadOnly    Boolean                   @default(false)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  status        ConversationStatus        @default(ACTIVE)
  lastMessageAt DateTime?
  messages      ChatMessage[]
  participants  ConversationParticipant[]
  section       Section?                  @relation(fields: [sectionId], references: [id])
  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([type])
  @@index([sectionId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String           @id @default(uuid())
  conversationId String
  userId         String
  role           ConversationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())
  lastReadAt     DateTime?
  isMuted        Boolean          @default(false)
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model ChatMessage {
  id             String        @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  type           MessageType   @default(TEXT)
  metadata       Json?         // attachment info, link previews, etc.
  replyToId      String?       // FK for reply threading
  deletedAt      DateTime?     // soft delete — null = not deleted
  editedAt       DateTime?     // set when content is updated
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo        ChatMessage?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ChatMessage[] @relation("MessageReplies")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@index([deletedAt])
  @@map("chat_messages")
}

model PushToken {
  id        String       @id @default(uuid())
  userId    String
  token     String       @unique
  platform  PushPlatform
  deviceId  String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model Message {
  id         String   @id @default(uuid())
  tenantId   String
  senderId   String
  receiverId String
  subject    String?
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
